  "tokenColors": [
    {
      "name": "Texto padrão",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#d8d6e8"
      }
    },
    {
      "name": "Comentários",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8B89AC",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comentários de documentação (tags)",
      "scope": [
        "comment.block.documentation keyword",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#b7a6d9",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#b18cf2"
      }
    },
    {
      "name": "Operadores",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#a09ec6"
      }
    },
    {
      "name": "Operadores de palavra (new, typeof, in, of)",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python"
      ],
      "settings": {
        "foreground": "#b18cf2"
      }
    },
    {
      "name": "Pontuação",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#a09ec6"
      }
    },
    {
      "name": "Interpolação de template",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#e68ad2"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#8fd6a8"
      }
    },
    {
      "name": "Escapes em strings",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#7fcdea"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#f2b076"
      }
    },
    {
      "name": "Números",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#f2b076"
      }
    },
    {
      "name": "Constantes e literais",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "support.constant"
      ],
      "settings": {
        "foreground": "#f2b076"
      }
    },
    {
      "name": "Constantes nomeadas",
      "scope": [
        "variable.other.constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#f2b076"
      }
    },
    {
      "name": "Funções (declaração e chamada)",
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#e68ad2"
      }
    },
    {
      "name": "Métodos",
      "scope": [
        "meta.method.declaration entity.name.function",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#e68ad2"
      }
    },
    {
      "name": "Classes e tipos",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#7fcdea",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tipos primitivos",
      "scope": [
        "support.type.primitive",
        "support.type.builtin",
        "keyword.type",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#7fcdea"
      }
    },
    {
      "name": "Interfaces e aliases (TS)",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.alias"
      ],
      "settings": {
        "foreground": "#7fcdea",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parâmetros",
      "scope": [
        "variable.parameter",
        "meta.parameters variable"
      ],
      "settings": {
        "foreground": "#b7a6d9",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variáveis",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#d8d6e8"
      }
    },
    {
      "name": "this, self, super",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#b18cf2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Propriedades",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#b7a6d9"
      }
    },
    {
      "name": "Decoradores",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#e68ad2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tags HTML/JSX",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#f0728f"
      }
    },
    {
      "name": "Componentes JSX/TSX",
      "scope": [
        "support.class.component",
        "entity.name.tag.tsx support.class.component"
      ],
      "settings": {
        "foreground": "#7fcdea"
      }
    },
    {
      "name": "Atributos HTML/JSX",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#e8d98a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS: seletores",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css",
        "meta.selector.css"
      ],
      "settings": {
        "foreground": "#e68ad2"
      }
    },
    {
      "name": "CSS: propriedades",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#7fcdea"
      }
    },
    {
      "name": "CSS: valores",
      "scope": [
        "support.constant.property-value.css",
        "meta.property-value.css",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#d8d6e8"
      }
    },
    {
      "name": "CSS: unidades",
      "scope": [
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#f2b076"
      }
    },
    {
      "name": "CSS: variáveis",
      "scope": [
        "variable.css",
        "variable.argument.css",
        "support.type.custom-property.name.css"
      ],
      "settings": {
        "foreground": "#b7a6d9"
      }
    },
    {
      "name": "Imports e exports",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.default"
      ],
      "settings": {
        "foreground": "#b18cf2"
      }
    },
    {
      "name": "Módulos importados",
      "scope": [
        "variable.other.readwrite.alias",
        "meta.import variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#d8d6e8"
      }
    },
    {
      "name": "JSON: chaves",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#b7a6d9"
      }
    },
    {
      "name": "Markdown: títulos",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#b18cf2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown: ênfase",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#e68ad2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown: negrito",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#f2b076",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown: código",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#8fd6a8"
      }
    },
    {
      "name": "Markdown: links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#7fcdea"
      }
    },
    {
      "name": "Markdown: listas e citações",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "markup.quote"
      ],
      "settings": {
        "foreground": "#e68ad2"
      }
    },
    {
      "name": "Diff inserido",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#8fd6a8"
      }
    },
    {
      "name": "Diff removido",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#f0728f"
      }
    },
    {
      "name": "Diff alterado",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#7fcdea"
      }
    },
    {
      "name": "Inválido",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f0728f"
      }
    },
    {
      "name": "Obsoleto",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#f2b076"
      }
    },
    {
      "name": "Shell: variáveis",
      "scope": [
        "variable.other.normal.shell",
        "punctuation.definition.variable.shell"
      ],
      "settings": {
        "foreground": "#b7a6d9"
      }
    },
    {
      "name": "SQL: keywords",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.DDL.sql",
        "keyword.other.create.sql"
      ],
      "settings": {
        "foreground": "#b18cf2"
      }
    }
  ],
  "semanticTokenColors": {
    "class": {
      "foreground": "#7fcdea",
      "italic": true
    },
    "interface": {
      "foreground": "#7fcdea",
      "italic": true
    },
    "type": {
      "foreground": "#7fcdea",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#7fcdea",
      "italic": true
    },
    "enum": {
      "foreground": "#7fcdea"
    },
    "enumMember": {
      "foreground": "#f2b076"
    },
    "namespace": {
      "foreground": "#7fcdea"
    },
    "function": {
      "foreground": "#e68ad2"
    },
    "method": {
      "foreground": "#e68ad2"
    },
    "parameter": {
      "foreground": "#b7a6d9",
      "italic": true
    },
    "property": {
      "foreground": "#b7a6d9"
    },
    "variable": {
      "foreground": "#d8d6e8"
    },
    "variable.readonly": {
      "foreground": "#f2b076"
    },
    "variable.defaultLibrary": {
      "foreground": "#7fcdea"
    },
    "*.deprecated": {
      "strikethrough": true
    },
    "decorator": {
      "foreground": "#e68ad2",
      "italic": true
    },
    "macro": {
      "foreground": "#e68ad2"
    }
  }
}
